	"width": 850,
	"height": 420,
	"title": {
		"text": "Secondhand Smoke Deaths Are Rising Alongside Smoking Deaths",
		"subtitle": "Summed disease-level tobacco-attributable deaths in Malaysia, 1990–2023",
		"anchor": "start",
		"fontSize": 20,
		"subtitleFontSize": 14
	},
	"layer": [
		{
			"data": {
				"url": "data/IHME-GBD_2023_DATA-bccf9300-1.csv",
