{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 320,
    "padding": {
        "left": 20,
        "right": 20,
        "top": 10,
        "bottom": 20
    },
    "title": {
        "text": "Awareness of E-Cigarette Facts Remains Low",
        "subtitle": "Percentage of ever-smokers by response to each awareness question",
        "anchor": "start",
        "fontSize": 22,
        "subtitleFontSize": 14,
        "font": "Arial, Helvetica, sans-serif",
        "subtitleFont": "Arial, Helvetica, sans-serif"
    },
    "data": {
        "url": "data/awareness_ecig_ever_used_cleaned.csv",
        "format": {
            "type": "csv"
        }
    },
    "transform": [
        {
            "filter": "datum.smoking_status == 'Ever Smoker'"
        },
        {
            "joinaggregate": [
                {
                    "op": "sum",
                    "field": "count",
                    "as": "total_count"
                }
            ],
            "groupby": [
                "question",
                "smoking_status"
            ]
        },
        {
            "calculate": "round(datum.count / datum.total_count * 100 * 10) / 10",
            "as": "pct"
        },
        {
            "calculate": "replace(replace(replace(datum.question, 'E-cig more harmful compare to tobacco cigarette', 'E-cigarette more harmful than tobacco cigarette'), 'E-cig contain nicotine', 'E-cigarette contain nicotine'), 'E-cig can be used in non-smoking area', 'E-cigarette can be used in non-smoking area')",
            "as": "question_full"
        }
    ],
    "facet": {
        "field": "question_full",
        "type": "nominal",
        "columns": 3,
        "header": {
            "title": null,
            "labelFontSize": 12,
            "labelLimit": 420,
            "labelAngle": 0,
            "labelAlign": "center",
            "labelFont": "Arial, Helvetica, sans-serif",
            "labelPadding": 12
        }
    },
    "spacing": 40,
    "spec": {
        "width": 160,
        "height": 160,
        "layer": [
            {
                "mark": {
                    "type": "arc",
                    "innerRadius": 55,
                    "outerRadius": 78,
                    "tooltip": true
                },
                "encoding": {
                    "theta": {
                        "field": "pct",
                        "type": "quantitative",
                        "stack": true
                    },
                    "color": {
                        "field": "answer",
                        "type": "nominal",
                        "scale": {
                            "domain": [
                                "Yes",
                                "No",
                                "Same",
                                "Don't know"
                            ],
                            "range": [
                                "#4A7FB5",
                                "#B54A3A",
                                "#C8962A",
                                "#8B9DAB"
                            ]
                        },
                        "legend": {
                            "title": "Response",
                            "orient": "bottom",
                            "labelFontSize": 12,
                            "titleFontSize": 12,
                            "symbolSize": 120,
                            "labelFont": "Arial, Helvetica, sans-serif",
                            "titleFont": "Arial, Helvetica, sans-serif",
                            "labelExpr": "datum.label == 'Same' ? 'Same (equally harmful as tobacco)' : datum.label == \"Don't know\" ? \"Don't know (uncertain)\" : datum.label",
                            "labelLimit": 400
                        }
                    },
                    "tooltip": [
                        {
                            "field": "question_full",
                            "title": "Question"
                        },
                        {
                            "field": "answer",
                            "title": "Response"
                        },
                        {
                            "field": "pct",
                            "title": "Percentage (%)",
                            "format": ".1f"
                        },
                        {
                            "field": "count",
                            "title": "Count",
                            "format": ",.0f"
                        }
                    ]
                }
            },
            {
                "transform": [
                    {
                        "filter": "datum.answer == 'Yes'"
                    }
                ],
                "mark": {
                    "type": "text",
                    "radius": 0,
                    "fontSize": 25,
                    "fontWeight": "bold",
                    "font": "Arial, Helvetica, sans-serif",
                    "color": "#1C1917",
                    "dy": -16,
                    "aria": false
                },
                "encoding": {
                    "text": {
                        "field": "pct",
                        "type": "quantitative",
                        "format": ".0f"
                    },
                    "tooltip": [
                        {
                            "field": "question_full",
                            "title": "Question"
                        },
                        {
                            "field": "answer",
                            "title": "Response"
                        },
                        {
                            "field": "pct",
                            "title": "Percentage (%)",
                            "format": ".1f"
                        },
                        {
                            "field": "count",
                            "title": "Count",
                            "format": ",.0f"
                        }
                    ]
                }
            },
            {
                "transform": [
                    {
                        "filter": "datum.answer == 'Yes'"
                    }
                ],
                "mark": {
                    "type": "text",
                    "radius": 0,
                    "fontSize": 11,
                    "font": "Arial, Helvetica, sans-serif",
                    "color": "#7A6E66",
                    "dy": 14,
                    "aria": false
                },
                "encoding": {
                    "text": {
                        "value": "said Yes"
                    },
                    "tooltip": [
                        {
                            "field": "question_full",
                            "title": "Question"
                        },
                        {
                            "field": "answer",
                            "title": "Response"
                        },
                        {
                            "field": "pct",
                            "title": "Percentage (%)",
                            "format": ".1f"
                        },
                        {
                            "field": "count",
                            "title": "Count",
                            "format": ",.0f"
                        }
                    ]
                }
            }
        ]
    },
    "config": {
        "background": "white",
        "font": "Arial, Helvetica, sans-serif",
        "view": {
            "stroke": "transparent"
        },
        "legend": {
            "labelFont": "Arial, Helvetica, sans-serif",
            "titleFont": "Arial, Helvetica, sans-serif"
        }
    }
}