{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 650,
    "height": 380,
    "padding": {
        "left": 100,
        "right": 30,
        "top": 30,
        "bottom": 40
    },
    "title": {
        "text": "Socio-demographic Profile of Ever-Smokers and Non-Smokers",
        "subtitle": "Looking into their behaviours",
        "anchor": "start",
        "fontSize": 22,
        "subtitleFontSize": 14
    },
    "data": {
        "url": "data/socio_demographic_overall_cleaned.csv"
    },
    "params": [
        {
            "name": "CategorySelect",
            "value": "Gender",
            "bind": {
                "input": "select",
                "options": [
                    "Gender",
                    "Ethnicity",
                    "Age",
                    "Education level",
                    "Marital status"
                ],
                "name": "Choose category: "
            }
        }
    ],
    "transform": [
        {
            "filter": "datum.category == CategorySelect"
        },
        {
            "filter": "datum.smoking_status != 'Total'"
        }
    ],
    "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4
    },
    "encoding": {
        "x": {
            "field": "percentage",
            "type": "quantitative",
            "title": "Proportion (%)",
            "stack": "normalize",
            "axis": {
                "format": ".0%"
            }
        },
        "y": {
            "field": "subgroup",
            "type": "nominal",
            "title": null,
            "sort": "-x",
            "axis": {
                "labelLimit": 170,
                "labelFontSize": 12
            }
        },
        "color": {
            "field": "smoking_status",
            "type": "nominal",
            "title": "Smoking Status",
            "scale": {
                "domain": ["Ever Smoker", "Non-Smoker"],
                "range": ["#B54A3A", "#BDBDBD"]
            },
            "legend": {
                "title": "Smoking Status",
                "orient": "top"
            }
        },
        "tooltip": [
            {
                "field": "category",
                "type": "nominal"
            },
            {
                "field": "subgroup",
                "type": "nominal"
            },
            {
                "field": "smoking_status",
                "type": "nominal"
            },
            {
                "field": "count",
                "type": "quantitative"
            },
            {
                "field": "percentage",
                "type": "quantitative",
                "format": ".1f"
            }
        ]
    }
}