{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
        "text": "Export Partner Rankings Have Shifted Over the Decade",
        "subtitle": "Rank by export value (RM) among Malaysia's top tobacco export destinations, 2010\u20132020",
        "anchor": "start",
        "fontSize": 22,
        "subtitleFontSize": 14
    },
    "width": 650,
    "height": 380,
    "padding": {
        "left": 10,
        "right": 120,
        "top": 30,
        "bottom": 40
    },
    "data": {
        "url": "data/trade_flows_6-2_6-3_combined_cleaned.csv",
        "format": {
            "type": "csv"
        }
    },
    "transform": [
        {
            "filter": "datum.trade_type == 'Export'"
        },
        {
            "filter": "datum.is_summary_row == 'False'"
        },
        {
            "calculate": "toNumber(datum.year)",
            "as": "yr"
        },
        {
            "calculate": "toNumber(datum.value_rm)",
            "as": "val"
        },
        {
            "window": [
                {
                    "op": "rank",
                    "as": "value_rank"
                }
            ],
            "sort": [
                {
                    "field": "val",
                    "order": "descending"
                }
            ],
            "groupby": [
                "yr"
            ]
        },
        {
            "filter": "datum.value_rank <= 8"
        },
        {
            "filter": "datum.country == 'Singapore' || datum.country == 'Indonesia' || datum.country == 'Thailand' || datum.country == 'Viet Nam' || datum.country == 'Philippines' || datum.country == 'Hong Kong'"
        }
    ],
    "layer": [
        {
            "mark": {
                "type": "line",
                "strokeWidth": 2.5
            },
            "encoding": {
                "x": {
                    "field": "yr",
                    "type": "ordinal",
                    "axis": {
                        "labelAngle": 0,
                        "title": null,
                        "labelFontSize": 12
                    }
                },
                "y": {
                    "field": "value_rank",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            1,
                            8
                        ],
                        "reverse": true
                    },
                    "axis": {
                        "title": "Rank (1 = top export destination)",
                        "tickCount": 8,
                        "values": [
                            1,
                            2,
                            3,
                            4,
                            5,
                            6,
                            7,
                            8
                        ],
                        "labelFontSize": 12,
                        "titleFontSize": 13
                    }
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Singapore",
                            "Indonesia",
                            "Thailand",
                            "Viet Nam",
                            "Philippines",
                            "Hong Kong"
                        ],
                        "range": [
                            "#7B2D8B",
                            "#D4A017",
                            "#C2185B",
                            "#5E35B1",
                            "#E8896A",
                            "#546E7A"
                        ]
                    },
                    "legend": null
                },
                "detail": {
                    "field": "country"
                }
            }
        },
        {
            "mark": {
                "type": "circle",
                "size": 80
            },
            "encoding": {
                "x": {
                    "field": "yr",
                    "type": "ordinal"
                },
                "y": {
                    "field": "value_rank",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            1,
                            8
                        ],
                        "reverse": true
                    }
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Singapore",
                            "Indonesia",
                            "Thailand",
                            "Viet Nam",
                            "Philippines",
                            "Hong Kong"
                        ],
                        "range": [
                            "#7B2D8B",
                            "#D4A017",
                            "#C2185B",
                            "#5E35B1",
                            "#E8896A",
                            "#546E7A"
                        ]
                    }
                },
                "tooltip": [
                    {
                        "field": "country",
                        "title": "Country"
                    },
                    {
                        "field": "yr",
                        "title": "Year"
                    },
                    {
                        "field": "value_rank",
                        "title": "Rank"
                    },
                    {
                        "field": "val",
                        "title": "Export value (RM)",
                        "format": ",.0f"
                    }
                ]
            }
        },
        {
            "transform": [
                {
                    "filter": "datum.yr == 2020"
                }
            ],
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 8,
                "fontSize": 12,
                "fontWeight": "bold"
            },
            "encoding": {
                "x": {
                    "field": "yr",
                    "type": "ordinal"
                },
                "y": {
                    "field": "value_rank",
                    "type": "quantitative",
                    "scale": {
                        "domain": [
                            1,
                            8
                        ],
                        "reverse": true
                    }
                },
                "text": {
                    "field": "country"
                },
                "color": {
                    "field": "country",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Singapore",
                            "Indonesia",
                            "Thailand",
                            "Viet Nam",
                            "Philippines",
                            "Hong Kong"
                        ],
                        "range": [
                            "#7B2D8B",
                            "#D4A017",
                            "#C2185B",
                            "#5E35B1",
                            "#E8896A",
                            "#546E7A"
                        ]
                    }
                }
            }
        }
    ],
    "config": {
        "background": "white",
        "view": {
            "stroke": "transparent"
        },
        "axis": {
            "labelFontSize": 12,
            "titleFontSize": 13,
            "gridColor": "#E8E0D5",
            "gridDash": [
                2,
                3
            ]
        }
    }
}